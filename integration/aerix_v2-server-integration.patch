+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://aerix.example/contracts/rf-detection.v1.schema.json",
+  "title": "Aerix RfDetection v1",
+  "description": "One second of RF observation from an SDR sensor (e.g. a HackRF box). Deliberately NOT an ODID reception: an RF detection is an energy/spectral measurement that may carry no decodable Remote ID at all, so it rides its own path (/v1/rf-detections:batch) and never touches the ODID observations pipeline. A detection may be verified=true when an ODID cue (from an ESP, via server poll or a local cue) coincided, making it a ground-truth-labelled sample.",
+  "type": "object",
+  "required": [
+    "schema_version",
+    "detection_id",
+    "sensor_id",
+    "captured_at",
+    "source",
+    "detection_probability",
+    "band"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
+    "detection_id": {
+      "description": "Sensor-generated unique id; idempotency key for re-upload.",
+      "type": "string",
+      "format": "uuid"
+    },
+    "sensor_id": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 128,
+      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
+    },
+    "captured_at": {
+      "description": "UTC time of the one-second window, RFC 3339 with millisecond precision.",
+      "type": "string",
+      "format": "date-time"
+    },
+    "source": {
+      "description": "Receiver family that produced this. 'hackrf' today; other SDRs later.",
+      "type": "string",
+      "enum": ["hackrf", "antsdr", "sdr"]
+    },
+    "receiver_position": {
+      "description": "Where the SDR sensor was. Used for Path-1 correlation and later triangulation.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["lat", "lon"],
+      "properties": {
+        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
+        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
+        "alt_m_wgs84": { "type": "number" },
+        "accuracy_m": { "type": "number", "minimum": 0 }
+      }
+    },
+    "detection_probability": {
+      "description": "Stage-1/2 confidence that a drone signal is present, 0..1.",
+      "type": "number",
+      "minimum": 0,
+      "maximum": 1
+    },
+    "rssi_dbm": {
+      "description": "Approximate received strength. HackRF power is uncalibrated (dBFS + gain offset).",
+      "type": "number"
+    },
+    "snr_db": { "type": "number" },
+    "band": { "type": "string", "enum": ["2.4GHz", "5.8GHz", "5GHz", "900MHz"] },
+    "center_freq_mhz": { "type": "number", "exclusiveMinimum": 0 },
+    "bandwidth_mhz": { "type": "number", "minimum": 0 },
+    "cadence_ms": {
+      "description": "Detected inter-burst period (a ~600 ms cadence is DroneID-like).",
+      "type": "number",
+      "minimum": 0
+    },
+    "signature_class": {
+      "type": "string",
+      "enum": ["dji_ocusync", "wifi_drone", "fpv_analog", "noise", "unknown"]
+    },
+    "verified": {
+      "description": "True when an ODID cue coincided -> this is a ground-truth-labelled drone sample.",
+      "type": "boolean",
+      "default": false
+    },
+    "spectrogram": {
+      "description": "The 'RF image' of this second. Inline PNG for the light path, or a reference when externalised.",
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "png_base64": { "type": "string", "contentEncoding": "base64", "maxLength": 4000000 },
+        "ref": { "type": "string", "maxLength": 512 },
+        "width": { "type": "integer", "minimum": 1 },
+        "height": { "type": "integer", "minimum": 1 }
+      }
+    },
+    "odid_cue": {
+      "description": "The ODID detection that triggered a Path-1 verified snapshot.",
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "track_id": { "type": "string", "maxLength": 64 },
+        "serial": { "type": "string", "maxLength": 64 },
+        "source": { "type": "string", "enum": ["server", "local"] },
+        "transport": { "type": "string", "maxLength": 32 }
+      }
+    },
+    "decoded": {
+      "description": "Best-effort DJI DroneID decode (OcuSync<=2.0). Operator location is personal data; retention-gated server-side.",
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "serial": { "type": "string", "maxLength": 64 },
+        "protocol": { "type": "string", "maxLength": 32 },
+        "drone_lat": { "type": "number", "minimum": -90, "maximum": 90 },
+        "drone_lon": { "type": "number", "minimum": -180, "maximum": 180 },
+        "operator_lat": { "type": "number", "minimum": -90, "maximum": 90 },
+        "operator_lon": { "type": "number", "minimum": -180, "maximum": 180 }
+      }
+    }
+  }
+}
