@@ -0,0 +1,11 @@
+-- 038: sensor class 'hackrf' -- the AERIX RF/SDR box (HackRF Pro on a small
+-- Linux box / Pi that runs the DSP the SDR cannot do onboard). Same anonymous
+-- provisioning path as the other sensors; the class exists so the fleet view
+-- can present RF sensors as their own population. Sensor ids are prefixed
+-- 'sdr-'. RF detections do NOT ride the ODID observations pipeline -- they use
+-- /v1/rf-detections:batch and the rf_detections table (039).
+--
+-- No BEGIN/COMMIT: ALTER TYPE ... ADD VALUE must not share a transaction
+-- with statements that use the new value.
+
+ALTER TYPE sensor_class ADD VALUE 'hackrf';
diff --git a/db/migrations/039_rf_detections.sql b/db/migrations/039_rf_detections.sql
new file mode 100644
index 0000000..2dc116e
--- /dev/null
+++ b/db/migrations/039_rf_detections.sql
@@ -0,0 +1,106 @@
+-- Aerix v2 -- 039: RF/SDR detections (the HackRF box; plan "AERIX RF").
+--
+-- Separate from observations by design: an observation is one reception of an
+-- Open Drone ID transmission (odid_raw mandatory); an RF detection is an
+-- energy/spectral measurement of a *second* of spectrum that may carry no
+-- decodable Remote ID at all. Keeping them apart preserves the append-only,
+-- ODID-only invariant of the observation layer.
+--
+-- Two producers write here (both Path-tagged on the row):
+--   Path 2  the box's own detector fired (detection_probability, rssi, image).
+--   Path 1  an ODID cue (from an ESP, via server poll or a local cue) coincided
+--           -> verified=true + odid_serial: a ground-truth-labelled sample.
+--
+-- Retention (section 9 / GDPR): every row is born with an expires_at and is
+-- swept by the worker exactly like observations. Decoded operator location is
+-- personal data, so the ingest path stamps the TIGHTEST expiry when `decoded`
+-- is present. Nothing here is retained indefinitely without an explicit
+-- evidence promotion.
+
+BEGIN;
+
+CREATE TABLE rf_detections (
+    detection_id          uuid PRIMARY KEY,
+    sensor_id             text NOT NULL REFERENCES sensors (sensor_id),
+    captured_at           timestamptz NOT NULL,
+    source                text NOT NULL,                 -- hackrf | antsdr | sdr
+
+    receiver_position     geography(Point, 4326),
+    receiver_accuracy_m   double precision,
+
+    detection_probability double precision NOT NULL
+                          CHECK (detection_probability >= 0 AND detection_probability <= 1),
+    rssi_dbm              double precision,
+    snr_db                double precision,
+    band                  text NOT NULL,
+    center_freq_mhz       double precision,
+    bandwidth_mhz         double precision,
+    cadence_ms            double precision,
+    signature_class       text,
+    verified              boolean NOT NULL DEFAULT false,
+
+    -- Path-1 ODID cue linkage: which certain-drone triggered the verified snapshot.
+    odid_track_id         uuid,
+    odid_serial           text,
+    odid_cue_source       text,                          -- server | local
+
+    -- Best-effort DJI DroneID decode (OcuSync<=2.0). operator_lat/lon is
+    -- personal data -> drives the tightest expires_at (see ingest writer).
+    decoded               jsonb,
+
+    -- The 'RF image' / samples. Inline bytea follows the evidence convention
+    -- (024); object_ref is the externalisation hook for large IQ/PNG.
+    -- content_sha256 covers whichever holds the bytes.
+    spectrogram_png       bytea,
+    content_sha256        text,
+    object_ref            text,
+
+    -- Retention bookkeeping, identical model to observations (014).
+    retention_class       retention_class NOT NULL DEFAULT 'STANDARD',
+    expires_at            timestamptz,
+    retain_until          timestamptz,
+
+    created_at            timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX rf_detections_sensor_time_idx ON rf_detections (sensor_id, captured_at DESC);
+CREATE INDEX rf_detections_expiry_idx      ON rf_detections (expires_at)
+    WHERE retention_class = 'STANDARD';
+CREATE INDEX rf_detections_verified_idx    ON rf_detections (captured_at DESC)
+    WHERE verified;
+CREATE INDEX rf_detections_position_idx    ON rf_detections USING gist (receiver_position);
+
+-- Append-only outside the retention sweep, and even then only expired STANDARD
+-- rows -- same guard the observation layer uses (014).
+CREATE OR REPLACE FUNCTION rf_detections_guarded_delete()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF current_setting('aerix.retention_sweep', true) IS DISTINCT FROM 'on' THEN
+        RAISE EXCEPTION 'rf_detections is append-only outside the retention sweep'
+            USING ERRCODE = 'raise_exception';
+    END IF;
+    IF OLD.retention_class <> 'STANDARD' THEN
+        RAISE EXCEPTION 'refusing to delete % row %', OLD.retention_class, OLD.detection_id
+            USING ERRCODE = 'raise_exception';
+    END IF;
+    IF OLD.expires_at IS NULL OR OLD.expires_at > now() THEN
+        RAISE EXCEPTION 'refusing to delete unexpired rf_detection %', OLD.detection_id
+            USING ERRCODE = 'raise_exception';
+    END IF;
+    RETURN OLD;
+END;
+$$;
+
+CREATE TRIGGER rf_detections_guarded_delete
+    BEFORE DELETE ON rf_detections
+    FOR EACH ROW EXECUTE FUNCTION rf_detections_guarded_delete();
+
+COMMENT ON TABLE rf_detections IS
+    'RF/SDR drone detections (HackRF box). Not ODID observations: an RF '
+    'detection is an energy/spectral measurement of one second of spectrum. '
+    'verified=true rows coincided with an ODID cue and are ground-truth labels.';
+COMMENT ON COLUMN rf_detections.decoded IS
+    'Best-effort DJI DroneID decode; operator_lat/lon is personal data and '
+    'drives the tightest expires_at at ingest.';
+
+COMMIT;
