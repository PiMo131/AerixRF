@@ -163,6 +168,82 @@ async def ingest_batch(
     )
 
 
+def get_rf_writer(request: Request) -> RfDetectionWriter:
+    return RfDetectionWriter(request.app.state.db)
+
+
+@app.post("/v1/rf-detections:batch")
+async def ingest_rf_detections(
+    payload: dict[str, Any],
+    sensor: AuthenticatedSensor = Depends(authenticate),
+    writer: RfDetectionWriter = Depends(get_rf_writer),
+) -> JSONResponse:
+    """RF/SDR detections (Path 2 + Path 1). Separate from /v1/observations:batch:
+    these are energy/spectral measurements, not ODID receptions."""
+    items = payload.get("rf_detections")
+    if not isinstance(items, list) or not items:
+        raise HTTPException(status_code=400, detail="rf_detections must be a non-empty array")
+    if len(items) > MAX_BATCH_ITEMS:
+        raise HTTPException(status_code=413, detail=f"batch of {len(items)} exceeds {MAX_BATCH_ITEMS}")
+
+    valid: list[dict[str, Any]] = []
+    rejected: list[dict[str, Any]] = []
+    for index, det in enumerate(items):
+        if not isinstance(det, dict):
+            rejected.append({"detection_id": None, "reason": f"item {index} is not an object",
+                             "retryable": False})
+            continue
+        if det.get("sensor_id") != sensor.sensor_id:
+            rejected.append({"detection_id": det.get("detection_id"),
+                             "reason": "sensor_id does not match authenticated credential",
+                             "retryable": False})
+            continue
+        try:
+            validate_rf_detection(det)
+        except EnvelopeRejected as exc:
+            rejected.append({"detection_id": det.get("detection_id"), "reason": exc.reason,
+                             "retryable": exc.retryable})
+            continue
+        valid.append(det)
+
+    stored, duplicates, db_rejected = writer.write_many(valid)
+    for did, reason in db_rejected:
+        rejected.append({"detection_id": did, "reason": reason, "retryable": False})
+
+    if rejected:
+        log.warning("rf sensor=%s batch=%d rejected=%d", sensor.sensor_id, len(items), len(rejected))
+
+    return JSONResponse(status_code=200,
+                        content={"accepted": stored, "duplicate": duplicates, "rejected": rejected})
+
+
+@app.get("/v1/rf/odid-cues")
+async def odid_cues(
+    request: Request,
+    sensor: AuthenticatedSensor = Depends(authenticate),
+) -> dict[str, Any]:
+    """Path 1a: recent ODID detections a HackRF box should snapshot as verified.
+
+    v1 returns every distinct serial seen across receivers in the last window;
+    site-scoping to the sensor's own site is a TODO (single-site deployments are
+    correct as-is)."""
+    cues: list[dict[str, Any]] = []
+    with request.app.state.db.cursor() as cur:
+        cur.execute(
+            """
+            SELECT DISTINCT ON (uas_id) uas_id, received_at_utc
+              FROM observations
+             WHERE uas_id IS NOT NULL
+               AND received_at_utc > now() - make_interval(secs => %s)
+             ORDER BY uas_id, received_at_utc DESC
+            """,
+            (ODID_CUE_WINDOW_S,),
+        )
+        for uas_id, seen in cur.fetchall():
+            cues.append({"serial": uas_id, "source": "server", "ts": seen.isoformat()})
+    return {"cues": cues}
+
