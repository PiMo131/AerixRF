diff --git a/services/ingest/aerix_ingest/storage/rf_writer.py b/services/ingest/aerix_ingest/storage/rf_writer.py
new file mode 100644
index 0000000..221ef43
--- /dev/null
+++ b/services/ingest/aerix_ingest/storage/rf_writer.py
@@ -0,0 +1,136 @@
+"""Persistence for RF/SDR detections (rf_detections, migration 039).
+
+Mirrors ObservationWriter: one savepoint per row so a poison item is a per-item
+rejection, not a batch abort. Retention is stamped at ingest (section 9 / GDPR):
+tiered expiry, TIGHTEST when a decoded operator location is present.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+from datetime import datetime, timedelta, timezone
+from typing import Any, Iterable
+
+# Retention windows (days), env-overridable. Bounded; nothing indefinite here.
+RF_RETENTION_DAYS = int(os.environ.get("AERIX_RF_RETENTION_DAYS", "30"))
+RF_VERIFIED_RETENTION_DAYS = int(os.environ.get("AERIX_RF_VERIFIED_RETENTION_DAYS", "180"))
+RF_DECODED_RETENTION_DAYS = int(os.environ.get("AERIX_RF_DECODED_RETENTION_DAYS", "7"))
+
+_COLUMNS: tuple[str, ...] = (
+    "detection_id", "sensor_id", "captured_at", "source",
+    "receiver_position", "receiver_accuracy_m",
+    "detection_probability", "rssi_dbm", "snr_db",
+    "band", "center_freq_mhz", "bandwidth_mhz", "cadence_ms",
+    "signature_class", "verified",
+    "odid_track_id", "odid_serial", "odid_cue_source",
+    "decoded", "spectrogram_png", "content_sha256", "object_ref",
+    "expires_at",
+)
+_JSONB = frozenset({"decoded"})
+
+_INSERT_SQL = f"""
+INSERT INTO rf_detections ({", ".join(_COLUMNS)})
+VALUES ({", ".join(f"%({c})s" for c in _COLUMNS)})
+ON CONFLICT (detection_id) DO NOTHING
+RETURNING detection_id
+"""
+
+
+def _parse_utc(value: str) -> datetime:
+    return datetime.fromisoformat(value.replace("Z", "+00:00"))
+
+
+def _point_wkt(pos: dict | None) -> str | None:
+    if not pos or pos.get("lat") is None or pos.get("lon") is None:
+        return None
+    return f"SRID=4326;POINT({pos['lon']} {pos['lat']})"
+
+
+def _expiry(captured_at: datetime, verified: bool, has_decoded: bool) -> datetime:
+    days = RF_VERIFIED_RETENTION_DAYS if verified else RF_RETENTION_DAYS
+    exp = captured_at + timedelta(days=days)
+    if has_decoded:
+        # Personal data (operator location) gets the tightest window.
+        exp = min(exp, captured_at + timedelta(days=RF_DECODED_RETENTION_DAYS))
+    # Never born already-expired (guards late store-and-forward flushes).
+    return max(exp, datetime.now(timezone.utc) + timedelta(hours=1))
+
+
+def _to_row(env: dict[str, Any]) -> dict[str, Any]:
+    captured_at = _parse_utc(env["captured_at"])
+    verified = bool(env.get("verified", False))
+    decoded = env.get("decoded")
+    cue = env.get("odid_cue") or {}
+    spec = env.get("spectrogram") or {}
+
+    png = None
+    sha = None
+    if spec.get("png_base64"):
+        png = base64.b64decode(spec["png_base64"])
+        sha = hashlib.sha256(png).hexdigest()
+
+    return {
+        "detection_id": env["detection_id"],
+        "sensor_id": env["sensor_id"],
+        "captured_at": captured_at,
+        "source": env["source"],
+        "receiver_position": _point_wkt(env.get("receiver_position")),
+        "receiver_accuracy_m": (env.get("receiver_position") or {}).get("accuracy_m"),
+        "detection_probability": env["detection_probability"],
+        "rssi_dbm": env.get("rssi_dbm"),
+        "snr_db": env.get("snr_db"),
+        "band": env["band"],
+        "center_freq_mhz": env.get("center_freq_mhz"),
+        "bandwidth_mhz": env.get("bandwidth_mhz"),
+        "cadence_ms": env.get("cadence_ms"),
+        "signature_class": env.get("signature_class"),
+        "verified": verified,
+        "odid_track_id": cue.get("track_id"),
+        "odid_serial": cue.get("serial"),
+        "odid_cue_source": cue.get("source"),
+        "decoded": decoded,
+        "spectrogram_png": png,
+        "content_sha256": sha,
+        "object_ref": spec.get("ref"),
+        "expires_at": _expiry(captured_at, verified, decoded is not None),
+    }
+
+
+def _prepare(row: dict[str, Any]) -> dict[str, Any]:
+    return {
+        c: json.dumps(row[c]) if c in _JSONB and row[c] is not None else row[c]
+        for c in _COLUMNS
+    }
+
+
+class RfDetectionWriter:
+    def __init__(self, conn: Any) -> None:
+        self._conn = conn
+
+    def write_many(
+        self, envelopes: Iterable[dict[str, Any]]
+    ) -> tuple[list[str], list[str], list[tuple[str, str]]]:
+        import psycopg
+
+        stored: list[str] = []
+        duplicates: list[str] = []
+        rejected: list[tuple[str, str]] = []
+
+        for env in envelopes:
+            did = str(env.get("detection_id"))
+            try:
+                row = _to_row(env)
+                with self._conn.transaction():
+                    with self._conn.cursor() as cur:
+                        cur.execute(_INSERT_SQL, _prepare(row))
+                        inserted = cur.fetchone() is not None
+                (stored if inserted else duplicates).append(did)
+            except psycopg.errors.IntegrityError as exc:
+                rejected.append((did, f"database refused row: {str(exc).splitlines()[0]}"))
+            except (KeyError, ValueError, TypeError) as exc:
+                rejected.append((did, f"unmappable rf detection: {exc}"))
+
+        return stored, duplicates, rejected
